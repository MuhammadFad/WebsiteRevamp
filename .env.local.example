# Copy to .env.local to point the site at a real backend instead of its built-in mock API.
#
# Leave this unset (or delete the file) to develop against the site's own mock routes under
# src/app/api/v1/ — they mirror the real backend's contract exactly, so no backend clone/setup
# is needed to work on the frontend.
#
# Set it to run against the real Express backend locally:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
#
# Or a deployed staging/production backend:
# NEXT_PUBLIC_API_URL=https://api.devlogix.com/api/v1
